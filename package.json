{
  "name": "24hours",
  "version": "1.0.0",
  "description": "24Hours - Intuitive day planner with 24-hour circle visualization",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "keywords": [
    "pwa",
    "day-planner",
    "time-management",
    "calendar"
  ],
  "author": "Lennart",
  "license": "MIT",
  "dependencies": {
    "localforage": "^1.10.0",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "jsdom": "^23.0.0",
    "prettier": "^3.1.1",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.0.4"
  }
}
